.{
    .{
        .name = "finding: a refused message writes one byte past max_len",
        .file = "src/inflate.zig",
        .old = "if (length > out.room()) return error.MessageTooLarge;",
        .new = "if (length > out.room() + 1) return error.MessageTooLarge;",
    },
    .{
        .name = "deflater keeps its window with context takeover off",
        .file = "src/root.zig",
        .old = "if (!self.options.context_takeover) try self.restart();",
        .new = "if (false) try self.restart();",
    },
    .{
        .name = "inflater keeps one byte less than the window",
        .file = "src/root.zig",
        .old = "const keep = @min(decoded.len, window_len);",
        .new = "const keep = @min(decoded.len, window_len - 1);",
    },
    .{
        .name = "inflater is not poisoned after an error",
        .file = "src/root.zig",
        .old = "        self.failed = true;",
        .new = "        self.failed = false;",
    },
    .{
        .name = "inflater stops after the first BFINAL block",
        .file = "src/inflate.zig",
        .old = "if (final) bits.alignToByte();",
        .new = "if (final) return;",
    },
    .{
        .name = "inflater writes a literal past the limit",
        .file = "src/inflate.zig",
        .old = "if (out.buf.items.len >= end) return error.MessageTooLarge;",
        .new = "if (out.buf.items.len > end) return error.MessageTooLarge;",
    },
    .{
        .name = "incomplete code tables are accepted",
        .file = "src/inflate.zig",
        .old = "if (left > 0 and (codelen_table or max != 1)) return error.InvalidData;",
        .new = "if (left > 0 and codelen_table) return error.InvalidData;",
    },
    .{
        .name = "a stored block's NLEN is not checked",
        .file = "src/inflate.zig",
        .old = "if (len != ~nlen) return error.InvalidData;",
        .new = "if (len != ~nlen and false) return error.InvalidData;",
    },
    .{
        .name = "287 and 288 length symbols or 31 and 32 distance symbols are accepted",
        .file = "src/inflate.zig",
        .old = "if (nlen > 286 or ndist > 30) return error.InvalidData;",
        .new = "if (nlen > 288 or ndist > 32) return error.InvalidData;",
    },
    .{
        .name = "input left over at the end of a payload is accepted",
        .file = "src/inflate.zig",
        .old = "return self.count == 0 and self.pos == self.size();",
        .new = "return self.pos == self.size();",
    },
    .{
        .name = "fast path: unrolled literals ignore the limit",
        .file = "src/inflate.zig",
        .old = "and len < end) {",
        .new = ") {",
    },
    .{
        .name = "fast path: a literal ignores the limit",
        .file = "src/inflate.zig",
        .old = "if (len >= end) break false;",
        .new = "if (false) break false;",
    },
    .{
        .name = "fast path: a match ignores the limit",
        .file = "src/inflate.zig",
        .old = "if (length > end -| len) break false;",
        .new = "if (false) break false;",
    },
    .{
        .name = "fast path: a distance past the history is accepted",
        .file = "src/inflate.zig",
        .old = "if (distance > len) return error.InvalidData;",
        .new = "if (false) return error.InvalidData;",
    },
    .{
        .name = "fast path: a short-distance pattern steps a whole word",
        .file = "src/inflate.zig",
        .old = "const step = 8 - 8 % distance;",
        .new = "const step = 8;",
    },
    .{
        .name = "fast path: 16-byte copies overlap their source",
        .file = "src/inflate.zig",
        .old = "if (distance >= 16) {",
        .new = "if (distance >= 9) {",
    },
}
